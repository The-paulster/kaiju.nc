					"name": "support.axis.a.gcode",
					"match": "(?<![A-Za-z])[Aa](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
