			"patterns": [
				{
					"name": "support.axis.v.gcode",
					"match": "(?<![A-Za-z])[Vv](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
