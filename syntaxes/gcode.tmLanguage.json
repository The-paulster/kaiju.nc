					"match": "(?<![A-Za-z])[Hh](?:\\d+|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"scodes": {
			"patterns": [
				{
					"name": "support.code.s.gcode",
					"match": "(?<![A-Za-z])[Ss](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"programnumbers": {
			"patterns": [
				{
					"name": "entity.name.program.gcode",
					"match": "(?<![A-Za-z])[Oo]\\d+(?!\\d)"
				}
			]
		},
		"logickeywords": {
			"patterns": [
				{
					"name": "keyword.control.logic.gcode",
					"match": "(?:\\b(?:IF|THEN|WHILE|DO|END|ENDIF|ELSE|GOTO)\\b|(?<![A-Za-z])(?:IF|WHILE)(?=\\s*\\[)|(?<![A-Za-z])(?:DO|END)(?=\\s*\\d)|(?<![A-Za-z])GOTO(?=\\s*(?:[-+]?\\d|#|\\[)))"
				}
			]
		},
		"xbracketvalues": {
			"patterns": [
				{
					"name": "support.axis.x.gcode",
					"begin": "(?<![A-Za-z])[Xx]\\[",
					"end": "\\]",
					"patterns": [
						{
							"include": "#mathwordoperators"
						},
						{
							"include": "#bracketnest"
						}
					]
				}
			]
		},
		"ybracketvalues": {
			"patterns": [
