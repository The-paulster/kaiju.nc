					"match": "(?<![A-Za-z])[Ww](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
