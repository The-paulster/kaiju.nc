				}
			]
		},
		"iwords": {
			"patterns": [
				{
					"name": "support.arc.i.gcode",
					"match": "(?<![A-Za-z])[Ii](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"jwords": {
			"patterns": [
				{
					"name": "support.arc.j.gcode",
					"match": "(?<![A-Za-z])[Jj](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"kwords": {
			"patterns": [
				{
					"name": "support.arc.k.gcode",
					"match": "(?<![A-Za-z])[Kk](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"lcodes": {
			"patterns": [
