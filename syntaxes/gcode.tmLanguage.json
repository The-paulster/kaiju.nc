	],
	"repository": {
		"metacomments": {
			"patterns": [
				{
					"name": "comment.meta.gcode",
					"match": "\\(/[^\\)]*\\)"
				}
			]
		},
		"equalscomments": {
			"patterns": [
				{
					"name": "comment.equals.gcode",
					"match": "\\(=[^\\)]*\\)"
				}
			]
		},
		"titlecomments": {
			"patterns": [
				{
					"name": "comment.title.gcode",
					"match": "\\(-[^\\)]*\\)"
				}
			]
		},
		"comments": {
			"name": "comment.line.gcode",
			"begin": "\\(",
			"end": "\\)",
			"patterns": [
				{
					"name": "comment.double.gcode",
					"begin": "\\[",
					"end": "\\]"
				},
				{
					"name": "comment.brace.gcode",
					"begin": "\\{",
					"end": "\\}"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.parameter.gcode",
					"match": "#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)"
				}
			]
		},
		"mcodes": {
			"patterns": [
				{
					"name": "keyword.control.mcode.gcode",
					"match": "(?<![A-Za-z])[Mm]\\d+(?!\\d)"
				}
			]
		},
		"blocknumbers": {
			"patterns": [
				{
					"name": "entity.block.number.gcode",
					"match": "(?<![A-Za-z])[Nn]\\d+(?!\\d)"
				}
			]
		},
		"rapidgcodes": {
			"patterns": [
				{
					"name": "keyword.motion.rapid.gcode",
					"match": "(?<![A-Za-z])[Gg]0+(?!\\d)"
				}
			]
		},
		"cuttinggcodes": {
			"patterns": [
				{
					"name": "keyword.motion.cut.gcode",
					"match": "(?<![A-Za-z])[Gg]0*[123](?!\\d)"
				}
			]
		},
		"gcodes": {
			"patterns": [
				{
					"name": "keyword.control.gcode",
					"match": "(?<![A-Za-z])[Gg](?!0+(?!\\d)|0*[123](?!\\d))\\d+(?!\\d)"
				}
			]
		},
		"mathoperators": {
			"patterns": [
				{
					"name": "keyword.operator.math.symbol.gcode",
					"match": "[+\\-*/=]"
				},
				{
					"name": "keyword.operator.math.word.gcode",
					"match": "(?:\\b(?:EQ|NE|GT|GE|LT|LE|AND|OR|XOR|MOD|SIN|COS|TAN|ATAN|SQRT|ABS|ROUND|FIX|FUP|LN|EXP)\\b|(?<=[\\d\\]])(?:EQ|NE|GT|GE|LT|LE|AND|OR|XOR|MOD)(?=[-+]?(?:\\d|#|\\[|\\.)))"
				}
			]
		},
		"mathwordoperators": {
			"patterns": [
				{
					"name": "keyword.operator.math.word.gcode",
					"match": "(?:\\b(?:EQ|NE|GT|GE|LT|LE|AND|OR|XOR|MOD|SIN|COS|TAN|ATAN|SQRT|ABS|ROUND|FIX|FUP|LN|EXP)\\b|(?<=[\\d\\]])(?:EQ|NE|GT|GE|LT|LE|AND|OR|XOR|MOD)(?=[-+]?(?:\\d|#|\\[|\\.)))"
				}
			]
		},
		"xwords": {
			"patterns": [
				{
					"name": "support.axis.x.gcode",
					"match": "(?<![A-Za-z])[Xx](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"ywords": {
			"patterns": [
				{
					"name": "support.axis.y.gcode",
					"match": "(?<![A-Za-z])[Yy](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"zwords": {
			"patterns": [
				{
					"name": "support.axis.z.gcode",
					"match": "(?<![A-Za-z])[Zz](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
				}
			]
		},
		"uwords": {
			"patterns": [
				{
					"name": "support.axis.u.gcode",
					"match": "(?<![A-Za-z])[Uu](?:[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)|[-+]?#(?:\\d+|[A-Za-z_][A-Za-z0-9_]*)|(?=\\[))"
